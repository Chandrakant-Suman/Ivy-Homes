# Ivy Homes backend configuration
# Copy this file to server/.env and fill in your values.

# Upstream property API
IVY_BASE_URL=https://solve.ivy.homes

# Your API key (scoped to one city). Keep this server-side only.
IVY_API_KEY=IVY26-A8E65BE102A0

# Port the backend listens on
PORT=4000

# Demo login for the one-click "Use demo account" button (server-side only).
# Default email is demo1@ivy.homes; put your key's demo password here.
IVY_DEMO_EMAIL=demo1@ivy.homes
IVY_DEMO_PASSWORD=
